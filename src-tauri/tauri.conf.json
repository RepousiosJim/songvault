{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "songvault",
  "version": "0.2.0",
  "identifier": "com.gemelon.songvault",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "songvault",
        "width": 1200,
        "height": 800,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5QjI3QzQ4OTM0NTY2NzEKUldSeFprV1RTSHl5MlFjcWpEV0dRK1I3K2FXQ25NNnErZU02aU1pQ005a1NNbWtHODlKK2lEazQK",
      "endpoints": ["https://github.com/RepousiosJim/songvault/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

